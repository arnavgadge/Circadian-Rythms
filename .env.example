# CircadianIQ environment configuration.
# Copy this file to .env and adjust values for your local setup.
# Values below are the defaults used when a variable is unset.

CIRCADIANIQ_ENV=development

# Database connection string.
# SQLite (default; local/course-project development):
CIRCADIANIQ_DATABASE_URL=sqlite:///data/circadianiq.db
# PostgreSQL (future deployment):
# CIRCADIANIQ_DATABASE_URL=postgresql://user:password@localhost:5432/circadianiq

# Optional directory overrides (default to paths under the project root)
# CIRCADIANIQ_DATA_DIR=./data
# CIRCADIANIQ_RAW_DATA_DIR=./data/raw
# CIRCADIANIQ_SYNTHETIC_DATA_DIR=./data/synthetic
# CIRCADIANIQ_PROCESSED_DATA_DIR=./data/processed
# CIRCADIANIQ_MODEL_DIR=./models

CIRCADIANIQ_LOG_LEVEL=INFO
